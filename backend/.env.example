# PostgreSQL connection string (see docker-compose.yml at the repo root)
DATABASE_URL="postgresql://user:password@localhost:5432/tabsum?schema=public"

# JWT secrets — generate strong random values, never reuse across environments
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""

# Seed data for the initial Admin account (used by prisma/seed.ts, Block 4)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Frontend origin allowed by CORS
FRONTEND_URL="http://localhost:5173"
